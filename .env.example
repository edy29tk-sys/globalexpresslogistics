# Frontend-safe Supabase project values (safe to expose under Supabase RLS)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Netlify server-side function values (NEVER prefix with VITE_)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional integrations — add only after creating accounts and configuring webhooks
RESEND_API_KEY=
EMAIL_FROM=Global Express Logistics <tracking@your-verified-domain.com>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
